---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import { company } from '../../data/company';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service: s } = Astro.props;
const others = services.filter((x) => x.slug !== s.slug);
const schema = [{
  '@context': 'https://schema.org', '@type': 'Service', name: s.title, description: s.short, serviceType: s.title,
  provider: { '@id': `${company.website}/#organization` }, areaServed: 'Europe',
  offers: { '@type': 'Offer', priceCurrency: 'EUR', description: `${s.pricing.model} — ${s.pricing.from}` },
}];
---
<Base title={s.title} description={s.heroLead} schema={schema}>
  <PageHero eyebrow="Service" title={s.title} lead={s.heroLead} crumbs={[{ label: 'Services', href: '/services' }, { label: s.title }]}>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/contact" class="btn-accent">Request a proposal <Icon name="arrow" class="h-4 w-4" /></a>
      <a href="#pricing" class="btn-ghost-light">See pricing</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Who it is for</p>
        <p class="mt-5 text-lg leading-relaxed text-ink-700">{s.forWho}</p>
        <div class="mt-10 rounded-2xl border border-ink-900/8 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-500">Always included</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {s.included.map((i) => <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-sea-600" />{i}</li>)}
          </ul>
        </div>
      </div>
      <div class="lg:col-span-8">
        <p class="eyebrow" data-reveal>Deliverables</p>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {s.deliverables.map((d, i) => <div class="card" data-reveal={String(Math.min(i + 1, 4))}><h3 class="h-card !text-lg">{d.t}</h3><p class="mt-2 text-sm leading-relaxed text-ink-600">{d.d}</p></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white !pt-0">
    <div class="container-x">
      <div class="rounded-3xl bg-ink-950 p-8 text-white sm:p-12">
        <p class="eyebrow eyebrow-light">How it runs</p>
        <ol class="mt-8 grid gap-8 md:grid-cols-3">
          {s.process.map((p, i) => <li><span class="font-display text-3xl font-bold text-sea-400">0{i + 1}</span><h3 class="mt-3 font-display text-lg font-semibold !text-white">{p.t}</h3><p class="mt-2 text-sm leading-relaxed text-mist-300">{p.d}</p></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section bg-white" id="pricing">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">Pricing</p>
        <h2 class="h-section mt-5">{s.pricing.from}</h2>
        <p class="mt-3 text-sm font-semibold uppercase tracking-wider text-ink-500">{s.pricing.model}</p>
        <p class="mt-6 text-ink-600">{s.pricing.note}</p>
        <p class="mt-4 text-sm text-ink-500">All prices in EUR, exclusive of VAT where applicable. Invoiced by {company.legalName}, Malta; payable by bank transfer or card within 14 days. Full terms on the <a href="/pricing" class="underline">pricing page</a> and in our <a href="/legal/terms" class="underline">Terms of Service</a>.</p>
      </div>
      <div class="lg:col-span-7" data-reveal="2">
        <p class="eyebrow">Questions about this service</p>
        <div class="mt-6"><Faq items={s.faq} /></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <p class="eyebrow">Other service lines</p>
      <div class="mt-6 grid gap-5 md:grid-cols-3">
        {others.map((o) => <a href={`/services/${o.slug}`} class="card group"><span class="flex h-10 w-10 items-center justify-center rounded-lg bg-ink-900 text-sea-400"><Icon name={o.icon} class="h-5 w-5" /></span><h3 class="h-card mt-5 !text-lg">{o.title}</h3><p class="mt-2 text-sm text-ink-600">{o.short}</p><span class="link-underline mt-4 inline-flex items-center gap-1 text-sm">Learn more <Icon name="arrow" class="h-4 w-4" /></span></a>)}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
