---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
---
<Base title="Services — E-commerce operations, technology, growth and multichannel" description="Four service lines, one accountable partner: e-commerce operations management, technology & integrations, growth & performance, multichannel sales management. Transparent monthly pricing.">
  <PageHero eyebrow="Services" title="Four service lines. One accountable partner for your online business." lead="Take one service line or combine them into a fully managed e-commerce operation. Every engagement has a written scope, a named manager and a monthly review." crumbs={[{ label: 'Services' }]} />
  <section class="section">
    <div class="container-x grid gap-8">
      {services.map((s) => (
        <article class="card grid gap-8 !p-8 lg:grid-cols-12 lg:!p-10" data-reveal>
          <div class="lg:col-span-5">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-ink-900 text-sea-400"><Icon name={s.icon} class="h-6 w-6" /></span>
            <h2 class="h-card mt-6 !text-2xl">{s.title}</h2>
            <p class="mt-3 text-ink-600">{s.heroLead}</p>
            <p class="mt-5 text-sm font-semibold text-ink-900">{s.pricing.from}</p>
            <p class="text-xs text-ink-500">{s.pricing.model}</p>
            <a href={`/services/${s.slug}`} class="btn-primary mt-7">Service details <Icon name="arrow" class="h-4 w-4" /></a>
          </div>
          <div class="lg:col-span-7">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-500">What you get</p>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {s.deliverables.map((d) => <li class="rounded-xl bg-sand-50 p-4"><div class="text-sm font-semibold text-ink-900">{d.t}</div><div class="mt-1 text-xs leading-relaxed text-ink-600">{d.d}</div></li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>
  <CtaBand title="Not sure which service line you need?" text="Start with a free discovery call. We will tell you what we would do first, what it would cost and what we would not recommend." />
</Base>
