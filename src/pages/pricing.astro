---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { company } from '../data/company';
const plans = [
  { name: 'Audit & Roadmap', price: '€3,500', unit: 'one-off', desc: 'A two-week review of your store, channels, systems and processes, with a written prioritised roadmap. Credited against your first retainer month if you proceed.', items: ['Store, channel & stack audit', 'Interviews with your team', 'Unit-economics review', 'Prioritised 12-month roadmap', 'Presentation to management'], cta: 'Book an audit', featured: false },
  { name: 'Managed Operations', price: 'from €2,500', unit: 'per month', desc: 'Your online store run day to day by a named team: catalogue, orders, customer care, promotions and reporting.', items: ['Named engagement manager', 'Documented SOPs you own', 'Business-hours coverage Mon–Fri', 'Weekly status & monthly KPI review', 'Add technology, growth or channels as modules'], cta: 'Request a proposal', featured: true },
  { name: 'Full-Service Partner', price: 'from €7,500', unit: 'per month', desc: 'Operations, technology, growth and multichannel sales managed as one programme with a single P&L view.', items: ['Everything in Managed Operations', 'Growth & paid media management', 'Multichannel sales management', 'Technical support SLA', 'Quarterly strategy review with the founder'], cta: 'Talk to the founder', featured: false },
];
const faq = [
  { q: 'Are these the final prices?', a: 'They are honest starting points. Every proposal is priced on your actual volumes, catalogue size, channels and languages, and the final figure is written into the service agreement before any work starts.' },
  { q: 'What is the minimum commitment?', a: 'Retainers have a three-month minimum term, after which they roll monthly with 30 days’ written notice. Projects are fixed-scope with milestone payments.' },
  { q: 'How do I pay?', a: `Invoices are issued by ${company.legalName} (Malta) in EUR and payable within 14 days by SEPA bank transfer or card. Retainers are billed monthly in advance; projects 40% on signature, balance on milestones.` },
  { q: 'Is VAT included?', a: 'Prices are exclusive of VAT. Maltese VAT is applied where required by law; for VAT-registered businesses in other EU countries the reverse-charge mechanism normally applies. Non-EU customers are generally outside the scope of Maltese VAT.' },
  { q: 'What happens to advertising budgets?', a: 'You pay advertising platforms, software subscriptions and licences directly. USN does not resell or mark up third-party spend, and never holds client funds.' },
  { q: 'Can I get a refund?', a: 'Yes, within the terms of our <a href="/legal/refunds">Refund, Cancellation & Delivery Policy</a>: unused prepaid retainer periods are refunded pro rata on cancellation, and project deposits are refundable before work begins.' },
];
---
<Base title="Pricing — transparent monthly retainers and fixed-price projects" description="Indicative pricing for USN’s e-commerce management services: audits from €3,500, managed operations from €2,500/month, full-service from €7,500/month. EUR, invoiced from Malta, no hidden costs.">
  <PageHero eyebrow="Pricing" title="Transparent pricing, written down before we start." lead="Indicative ranges below; a written proposal fixes the exact figure for your scope. All prices in EUR, exclusive of VAT, invoiced by USN Ltd. (Malta) and payable by bank transfer or card." crumbs={[{ label: 'Pricing' }]} />

  <section class="section">
    <div class="container-x grid gap-6 lg:grid-cols-3">
      {plans.map((p, i) => (
        <div class:list={['relative flex flex-col rounded-3xl p-8', p.featured ? 'bg-ink-950 text-white shadow-lift' : 'card !p-8']} data-reveal={String(i + 1)}>
          {p.featured && <span class="absolute -top-3 left-8 rounded-full bg-sea-500 px-3 py-1 text-xs font-semibold text-ink-950">Most common</span>}
          <h2 class:list={['font-display text-xl font-semibold', p.featured ? 'text-white' : 'text-ink-900']}>{p.name}</h2>
          <div class="mt-5 flex items-baseline gap-2"><span class:list={['font-display text-4xl font-bold', p.featured ? 'text-white' : 'text-ink-900']}>{p.price}</span><span class:list={['text-sm', p.featured ? 'text-mist-400' : 'text-ink-500']}>{p.unit}</span></div>
          <p class:list={['mt-4 text-sm leading-relaxed', p.featured ? 'text-mist-300' : 'text-ink-600']}>{p.desc}</p>
          <ul class:list={['mt-6 flex-1 space-y-2.5 border-t pt-6 text-sm', p.featured ? 'border-white/10' : 'border-ink-900/8']}>
            {p.items.map((it) => <li class="flex gap-2.5"><Icon name="check" class:list={['mt-0.5 h-4 w-4 shrink-0', p.featured ? 'text-sea-400' : 'text-sea-600']} />{it}</li>)}
          </ul>
          <a href="/contact" class:list={['mt-8', p.featured ? 'btn-accent' : 'btn-primary']}>{p.cta} <Icon name="arrow" class="h-4 w-4" /></a>
        </div>
      ))}
    </div>
  </section>

  <section class="section bg-white !pt-0">
    <div class="container-x">
      <p class="eyebrow">By service line</p>
      <h2 class="h-section mt-5 max-w-2xl">Indicative pricing per service line.</h2>
      <div class="mt-10 overflow-x-auto rounded-2xl border border-ink-900/8">
        <table class="w-full min-w-[720px] text-sm">
          <thead class="bg-sand-100 text-left text-xs uppercase tracking-wider text-ink-500"><tr><th class="px-6 py-4 font-semibold">Service</th><th class="px-6 py-4 font-semibold">Model</th><th class="px-6 py-4 font-semibold">Indicative price</th><th class="px-6 py-4 font-semibold">Notes</th></tr></thead>
          <tbody class="divide-y divide-ink-900/8">
            {services.map((s) => <tr class="align-top"><td class="px-6 py-5 font-semibold text-ink-900"><a href={`/services/${s.slug}`} class="hover:underline">{s.title}</a></td><td class="px-6 py-5 text-ink-700">{s.pricing.model}</td><td class="px-6 py-5 font-semibold text-ink-900">{s.pricing.from}</td><td class="px-6 py-5 text-ink-600">{s.pricing.note}</td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs text-ink-500">All prices in EUR, exclusive of VAT. Indicative ranges current as of {new Date().toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}; the price for your engagement is fixed in the written proposal.</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4"><p class="eyebrow">Billing questions</p><h2 class="h-section mt-5">Payment terms, VAT and refunds.</h2></div>
      <div class="lg:col-span-8"><Faq items={faq} /></div>
    </div>
  </section>
  <CtaBand title="Want an exact figure?" text="Tell us about your store and channels. You will receive a written proposal with a fixed price within five business days of the discovery call." />
</Base>
