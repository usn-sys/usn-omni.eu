---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company, fullAddress } from '../data/company';

interface Props {
  title: string;
  description: string;
  /** Path to OG image, defaults to /og.png */
  image?: string;
  /** Extra JSON-LD objects to inject */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, image = '/og.png', schema = [], noindex = false } = Astro.props;
const _p = Astro.url.pathname.replace(/\/$/, '');
const canonical = new URL(_p ? `${_p}/` : '/', Astro.site).href;
const fullTitle = title.includes('USN') ? title : `${title} · USN`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${company.website}/#organization`,
  name: company.legalName,
  alternateName: company.brand,
  legalName: company.legalName,
  url: company.website,
  logo: `${company.website}/logo.svg`,
  email: company.email,
  telephone: company.phone,
  description: company.tagline,
  identifier: { '@type': 'PropertyValue', propertyID: 'Malta Business Registry company number', value: company.registrationNumber },
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${company.address.line1}, ${company.address.line2}`,
    addressLocality: company.address.city,
    postalCode: company.address.postcode,
    addressCountry: 'MT',
  },
  founder: { '@type': 'Person', name: company.founder.name, jobTitle: company.founder.role, sameAs: company.founder.linkedin },
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'sales', email: company.email, telephone: company.phone, availableLanguage: company.languages }],
  areaServed: 'Worldwide',
};
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b1120" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site).href} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-white">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal-on-scroll for elements marked data-reveal
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        els.forEach((el) => io.observe(el));
      } else { els.forEach((el) => el.classList.add('is-visible')); }
    </script>
    <style is:global>
      [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .7s cubic-bezier(.22,1,.36,1), transform .7s cubic-bezier(.22,1,.36,1); }
      [data-reveal].is-visible { opacity: 1; transform: none; }
      [data-reveal="2"] { transition-delay: .1s } [data-reveal="3"] { transition-delay: .2s } [data-reveal="4"] { transition-delay: .3s }
      @media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1; transform: none; } }
    </style>
  </body>
</html>
