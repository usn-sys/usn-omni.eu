---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company, fullAddress } from '../data/company';
import { serviceNav, legalNav } from '../data/nav';
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-ink-950 text-mist-300">
  <div class="absolute inset-0 grid-bg opacity-60"></div>
  <div class="container-x relative">
    <div class="grid gap-12 py-16 lg:grid-cols-12 lg:py-20">
      <div class="lg:col-span-4">
        <Logo light class="h-9" />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-mist-400">{company.tagline}</p>
        <p class="mt-3 font-display text-sm font-semibold italic text-sea-300">“{company.motto}”</p>
        <div class="mt-8 space-y-3 text-sm">
          <a href={`mailto:${company.email}`} class="flex items-start gap-3 hover:text-white"><Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-sea-400" />{company.email}</a>
          <a href={company.phoneHref} class="flex items-start gap-3 hover:text-white"><Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-sea-400" />{company.phone}</a>
          <div class="flex items-start gap-3"><Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-sea-400" /><address class="not-italic leading-relaxed">{company.address.line1}<br />{company.address.line2}<br />{company.address.city} {company.address.postcode}, {company.address.country}</address></div>
          <div class="flex items-start gap-3"><Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-sea-400" />{company.hours}</div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-8 lg:pl-10">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-white">Services</h3>
          <ul class="mt-5 space-y-3 text-sm">
            {serviceNav.map((s) => <li><a href={s.href} class="hover:text-white">{s.label}</a></li>)}
            <li><a href="/pricing" class="hover:text-white">Pricing &amp; engagement models</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-white">Company</h3>
          <ul class="mt-5 space-y-3 text-sm">
            <li><a href="/about" class="hover:text-white">About USN</a></li>
            <li><a href="/founder" class="hover:text-white">The founder</a></li>
            <li><a href="/how-we-work" class="hover:text-white">How we work</a></li>
            <li><a href="/faq" class="hover:text-white">FAQ</a></li>
            <li><a href="/contact" class="hover:text-white">Contact</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-white">Legal</h3>
          <ul class="mt-5 space-y-3 text-sm">
            {legalNav.map((l) => <li><a href={l.href} class="hover:text-white">{l.label}</a></li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 py-8 text-xs leading-relaxed text-mist-400">
      <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <p class="max-w-3xl">
          © {year} <strong class="font-semibold text-white">{company.legalName}</strong> — {company.legalForm}. Company registration number <strong class="text-white">{company.registrationNumber}</strong> ({company.registry}).{company.vatNumber && <> VAT number <strong class="text-white">{company.vatNumber}</strong>.</>} Registered office: {fullAddress}.
        </p>
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-white/10 px-3 py-1"><Icon name="lock" class="h-3.5 w-3.5 text-sea-400" /> Secured with HTTPS</span>
          <a href={company.founder.linkedin} rel="noopener" target="_blank" class="inline-flex items-center gap-1.5 hover:text-white" aria-label="LinkedIn"><Icon name="linkedin" class="h-4 w-4" /> LinkedIn</a>
        </div>
      </div>
    </div>
  </div>
</footer>
